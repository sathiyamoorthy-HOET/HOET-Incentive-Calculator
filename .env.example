# Supabase project settings -> Data API / API keys
# Server-only: no NEXT_PUBLIC_ prefix, because nothing in the browser talks to
# Supabase directly. All access goes through Server Actions and the proxy.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>

# Optional. Only the Access page uses this, to create and delete accounts.
# Supabase project settings -> API keys -> service_role. It ignores row-level
# security, so keep it server-side: no NEXT_PUBLIC_ prefix, never in the client
# bundle. Without it the app runs as normal and accounts are created in the
# Supabase dashboard instead.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
